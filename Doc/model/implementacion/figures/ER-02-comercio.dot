digraph G { graph [rankdir=TB,bgcolor="white",pad=0.5,nodesep=0.35,ranksep=0.75,splines=polyline,concentrate=false,fontname="Arial"]; node [shape=plain,fontname="Arial",fontsize=13]; edge [fontname="Arial",fontsize=11,color="#60756c",penwidth=1.2,arrowsize=1.1]; catalog_products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>catalog_products</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Producto del catálogo de un negocio</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>business_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">name<FONT COLOR="#5d7268"> : varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT">description<FONT COLOR="#5d7268"> : varchar(2000)</FONT></TD></TR><TR><TD ALIGN="LEFT">category<FONT COLOR="#5d7268"> : varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT">price<FONT COLOR="#5d7268"> : numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT">currency<FONT COLOR="#5d7268"> : varchar(3)</FONT></TD></TR><TR><TD ALIGN="LEFT">available<FONT COLOR="#5d7268"> : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">status<FONT COLOR="#5d7268"> : varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">version<FONT COLOR="#5d7268"> : integer</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">updated_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">is_suspended<FONT COLOR="#5d7268"> : boolean</FONT></TD></TR></TABLE>>];
