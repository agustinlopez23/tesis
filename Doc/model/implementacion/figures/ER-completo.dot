7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR></TABLE>>]; order_lines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>order_lines</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Producto incluido en una solicitud</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>order_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>product_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT">name<FONT COLOR="#5d7268"> : varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT">unit_price<FONT COLOR="#5d7268"> : numeric(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT">currency<FONT COLOR="#5d7268"> : varchar(3)</FONT></TD></TR><TR><TD ALIGN="LEFT">quantity<FONT COLOR="#5d7268"> : integer</FONT></TD></TR><TR><TD ALIGN="LEFT">product_version<FONT COLOR="#5d7268"> : integer</FONT></TD></TR></TABLE>>]; order_changes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>order_changes</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Historial de estados de una solicitud</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>order_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>version</U></B><FONT COLOR="#5d7268"> : integer</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>actor_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">from_status<FONT COLOR="#5d7268"> : varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">to_status<FONT COLOR="#5d7268"> : varc