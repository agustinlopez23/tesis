digraph G { graph [rankdir=TB,bgcolor="white",pad=0.5,nodesep=0.7,ranksep=1.4,splines=polyline,concentrate=false,fontname="Arial"]; node [shape=plain,fontname="Arial",fontsize=13]; edge [fontname="Arial",fontsize=11,color="#60756c",penwidth=1.2,arrowsize=1.1]; subgraph cluster_g0 { label="Negocios, identidad y planes"; labeljust="l"; fontname="Arial"; fontsize=17; fontcolor="#1d4030"; style="rounded"; color="#8fa79a"; penwidth=1.6; margin=18; user_accounts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>user_accounts</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Cuenta de usuario con credenciales y estado de acceso</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT">email<FONT COLOR="#5d7268"> : varchar(254)</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   UK</FONT></TD></TR><TR><TD ALIGN="LEFT">display_name<FONT COLOR="#5d7268"> : varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT">password_hash<FONT COLOR="#5d7268"> : text</FONT></TD></TR><TR><TD ALIGN="LEFT">is_suspended<FONT COLOR="#5d7268"> : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">failed_login_count<FONT COLOR="#5d7268"> : integer</FONT></TD></TR><TR><TD ALIGN="LEFT">locked_until<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR></TABLE>>]; roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>roles</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Rol de la plataforma</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : smallint</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT">name<FONT COLOR="#5d7268"> : varchar(50)</FONT><FONT COLOR="#8a6a3