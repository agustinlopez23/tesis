TD ALIGN="LEFT"><I>revoked_by</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">revocation_reason<FONT COLOR="#5d7268"> : varchar(500)</FONT></TD></TR></TABLE>>]; admin_actions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>admin_actions</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Auditoría de acciones del administrador</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : bigint</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>actor_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">target_type<FONT COLOR="#5d7268"> : varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">target_id<FONT COLOR="#5d7268"> : varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT">target_label<FONT COLOR="#5d7268"> : varchar(254)</FONT></TD></TR><TR><TD ALIGN="LEFT">action<FONT COLOR="#5d7268"> : varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">reason<FONT COLOR="#5d7268"> : varchar(500)</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR></TABLE>>]; }
