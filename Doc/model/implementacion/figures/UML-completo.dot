digraph G { graph [rankdir=TB,bgcolor="white",pad=0.5,nodesep=0.7,ranksep=1.4,splines=polyline,concentrate=false,fontname="Arial"]; node [shape=plain,fontname="Arial",fontsize=13]; edge [fontname="Arial",fontsize=11,color="#60756c",penwidth=1.2,arrowsize=1.1]; subgraph cluster_g0 { label="Negocios, identidad y planes"; labeljust="l"; fontname="Arial"; fontsize=17; fontcolor="#1d4030"; style="rounded"; color="#8fa79a"; penwidth=1.6; margin=18; UserAccount [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>UserAccount</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Cuenta de usuario</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− Email<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− DisplayName<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− PasswordHash<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− IsSuspended<FONT COLOR="#5d7268"> : bool</FONT></TD></TR><TR><TD ALIGN="LEFT">− FailedLoginCount<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− LockedUntil<FONT COLOR="#5d7268"> : DateTimeOffset?</FONT></TD></TR><TR><TD ALIGN="LEFT">− CreatedAt<FONT COLOR="#5d7268"> : DateTimeOffset</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ RegisterAsync(): RegistrationResult</TD></TR><TR><TD ALIGN="LEFT">+ LoginAsync(): LoginResult</TD></TR><TR><TD ALIGN="LEFT">+ ModerateAsync(): AdminStatus</TD></TR></TABLE>>]; Role [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>Role</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Rol de la plataforma</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− Name<FONT COLOR="#5d7268"> : string</FONT></TD></TR></TABLE>>]; UserAccountRole [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>UserAccountRole</B></TD></TR><TR><TD BG