digraph G { graph [rankdir=TB,bgcolor="white",pad=0.5,nodesep=0.35,ranksep=0.75,splines=polyline,concentrate=false,fontname="Arial"]; node [shape=plain,fontname="Arial",fontsize=13]; edge [fontname="Arial",fontsize=11,color="#60756c",penwidth=1.2,arrowsize=1.1]; CatalogProduct [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>CatalogProduct</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Producto del catálogo</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− Name<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− Description<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− Category<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− Price<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− Currency<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− Available<FONT COLOR="#5d7268"> : bool</FONT></TD></TR><TR><TD ALIGN="LEFT">− Status<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− IsSuspended<FONT COLOR="#5d7268"> : bool</FONT></TD></TR><TR><TD ALIGN="LEFT">− Version<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− CreatedAt<FONT COLOR="#5d7268"> : DateTimeOffset</FONT></TD></TR><TR><TD ALIGN="LEFT">− UpdatedAt<FONT COLOR="#5d7268"> : DateTimeOffset</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ SaveAsync(): CatalogResult</TD></TR><TR><TD ALIGN="LEFT">+ PublicAsync(): PublicCatalogResponse</TD></TR><TR><TD ALIGN="LEFT">+ Generate(): CatalogDraftResult</TD></TR><TR><TD ALIGN="LEFT">+ Read(): ProductDiscoveryResponse</TD></TR></TABLE>>];
ProductPhoto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>ProductPhoto</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Fotografía del producto</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− Content<FONT COLOR="#5d7268"> : byte[]</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ PhotoAsync(): CatalogResult</TD></TR><TR><TD ALIGN="LEFT">+ ReadPhotoAsync(): byte[]</TD></TR></TABLE>>];
InventoryBalance [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>InventoryBalance</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Saldo de stock</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− Quantity<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− Version<FONT COLOR="#5d7268"> : int</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Inventory(): object</TD></TR><TR><TD ALIGN="LEFT">+ Adjust(): SalesResult</TD></TR></TABLE>>];
InventoryMovement [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>InventoryMovement</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Movimiento de stock</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− Delta<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− Balance<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− Kind<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− Reason<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− RequestHash<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− CreatedAt<FONT COLOR="#5d7268"> : DateTimeOffset</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Movements(): object</TD></TR></TABLE>>];
CustomerOrder [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>CustomerOrder</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Solicitud de compra</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− Reference<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− CustomerName<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− BusinessName<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− WhatsApp<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− AccessKeyHash<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− RequestHash<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− AccessExpiresAt<FONT COLOR="#5d7268"> : DateTimeOffset</FONT></TD></TR><TR><TD ALIGN="LEFT">− CreatedAt<FONT COLOR="#5d7268"> : DateTimeOffset</FONT></TD></TR><TR><TD ALIGN="LEFT">− UpdatedAt<FONT COLOR="#5d7268"> : DateTimeOffset</FONT></TD></TR><TR><TD ALIGN="LEFT">− ContactReceivedAt<FONT COLOR="#5d7268"> : DateTimeOffset?</FONT></TD></TR><TR><TD ALIGN="LEFT">− Status<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− Source<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− Version<FONT COLOR="#5d7268"> : int</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ CreateAsync(): OrderResult</TD></TR><TR><TD ALIGN="LEFT">+ GuestAsync(): OrderResponse</TD></TR><TR><TD ALIGN="LEFT">+ ListAsync(): OrderPageResponse</TD></TR><TR><TD ALIGN="LEFT">+ UpdateAsync(): OrderResult</TD></TR></TABLE>>];
