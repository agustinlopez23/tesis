digraph G { graph [rankdir=TB,bgcolor="white",pad=0.5,nodesep=0.35,ranksep=0.75,splines=polyline,concentrate=false,fontname="Arial"]; node [shape=plain,fontname="Arial",fontsize=13]; edge [fontname="Arial",fontsize=11,color="#60756c",penwidth=1.2,arrowsize=1.1]; ranking_contexts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>ranking_contexts</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Contexto de ranking (zona y rubro) con su secuencia</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>context_key</U></B><FONT COLOR="#5d7268"> : varchar(200)</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT">sequence<FONT COLOR="#5d7268"> : bigint</FONT></TD></TR></TABLE>>];
ranking_snapshots [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>ranking_snapshots</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Orden publicado del ranking para una solicitud</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT">request_id<FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>context_key</I><FONT COLOR="#5d7268"> : varchar(200)</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">expires_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">payload<FONT COLOR="#5d7268"> : jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">policy_label<FONT COLOR="#5d7268"> : varchar(40)</FONT></TD></TR></TABLE>>];
ranking_opportunities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>ranking_opportunities</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Oportunidad de exposición auditada</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>context_key</I><FONT COLOR="#5d7268"> : varchar(200)</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK UK</FONT></TD></TR><TR><TD ALIGN="LEFT">sequence<FONT COLOR="#5d7268"> : bigint</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   UK</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">payload<FONT COLOR="#5d7268"> : jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">policy_label<FONT COLOR="#5d7268"> : varchar(40)</FONT></TD></TR></TABLE>>];
ranking_contributions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>ranking_contributions</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Exposición esperada y recibida por negocio</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>opportunity_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>business_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT">expected<FONT COLOR="#5d7268"> : float8</FONT></TD></TR><TR><TD ALIGN="LEFT">received<FONT COLOR="#5d7268"> : float8</FONT></TD></TR></TABLE>>];
campaigns [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>campaigns</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Campaña publicitaria pagada</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>business_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>product_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">photo_slot<FONT COLOR="#5d7268"> : integer</FONT></TD></TR><TR><TD ALIGN="LEFT">image<FONT COLOR="#5d7268"> : bytea</FONT></TD></TR><TR><TD ALIGN="LEFT">title<FONT COLOR="#5d7268"> : varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT">description<FONT COLOR="#5d7268"> : varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT">conditions<FONT COLOR="#5d7268"> : varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT">zone_id<FONT COLOR="#5d7268"> : varchar(32)</FONT></TD></TR><TR><TD ALIGN="LEFT">starts_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">ends_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">status<FONT COLOR="#5d7268"> : varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT">version<FONT COLOR="#5d7268"> : integer</FONT></TD></TR><TR><TD ALIGN="LEFT">save_hash<FONT COLOR="#5d7268"> : varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT">approved_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">paid_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">payment_reference<FONT COLOR="#5d7268"> : varchar(120)</FONT></TD></TR></TABLE>>];
campaign_changes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>campaign_changes</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Historial de acciones sobre una campaña</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>operation_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>campaign_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>actor_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">version<FONT COLOR="#5d7268"> : integer</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   UK</FONT></TD></TR><TR><TD ALIGN="LEFT">action<FONT COLOR="#5d7268"> : varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT">reason<FONT COLOR="#5d7268"> : varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT">request_hash<FONT COLOR="#5d7268"> : varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR></TABLE>>];
campaign_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>campaign_events</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Impresión o clic de una campaña</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>campaign_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>context_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>kind</U></B><FONT COLOR="#5d7268"> : varchar(16)</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR></TABLE>>];
business_activity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>business_activity</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Exposición e interacción observada de un negocio</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>visit_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>business_id</U></B><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>kind</U></B><FONT COLOR="#5d7268"> : varchar(20)</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><U>surface</U></B><FONT COLOR="#5d7268"> : varchar(20)</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT">source<FONT COLOR="#5d7268"> : varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">position<FONT COLOR="#5d7268"> : integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ranking_version<FONT COLOR="#5d7268"> : varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR></TABLE>>];
owner_activity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>owner_activity</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Actualización sustantiva del responsable</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><B><U>id</U></B><FONT COLOR="#5d7268"> : bigint</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><I>business_id</I><FONT COLOR="#5d7268"> : uuid</FONT><FONT COLOR="#8a6a3c" POINT-SIZE="10">   FK</FONT></TD></TR><TR><TD ALIGN="LEFT">kind<FONT COLOR="#5d7268"> : varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT">occurred_at<FONT COLOR="#5d7268"> : timestamptz</FONT></TD></TR></TABLE>>]; ranking_contexts -> ranking_snapshots [dir=both,arrowtail=teetee,arrowhead=crowodot,label="publica",fontsize=11,fontcolor="#3c5a4b"];
ranking_contexts -> ranking_opportunities [dir=both,arrowtail=teetee,arrowhead=crowodot,label="secuencia",fontsize=11,fontcolor="#3c5a4b"];
