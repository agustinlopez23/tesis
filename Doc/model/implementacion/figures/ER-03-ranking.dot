campaigns -> campaign_changes [dir=both,arrowtail=teetee,arrowhead=crowodot,label="registra",fontsize=11,fontcolor="#3c5a4b"];
campaigns -> campaign_events [dir=both,arrowtail=teetee,arrowhead=crowodot,label="mide",fontsize=11,fontcolor="#3c5a4b"];
