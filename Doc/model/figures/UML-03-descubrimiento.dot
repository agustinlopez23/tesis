digraph G { graph [rankdir=LR,bgcolor="white",pad=0.4,nodesep=0.5,ranksep=1.2]; node [shape=plain,fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#60756c"]; RankingConfiguration [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>RankingConfiguration</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Versión inmutable del algoritmo</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− version: string</TD></TR><TR><TD ALIGN="LEFT">− context: string</TD></TR><TR><TD ALIGN="LEFT">− parameters: json</TD></TR><TR><TD ALIGN="LEFT">− created_at: datetime</TD></TR><HR/><TR><TD ALIGN="LEFT">+ validate(): boolean</TD></TR></TABLE>>];
DiscoveryRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>DiscoveryRequest</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Consulta o entrada a la revista</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− configuration_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− consumer_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− session_key: string</TD></TR><TR><TD ALIGN="LEFT">− context: string</TD></TR><TR><TD ALIGN="LEFT">− query_text: string</TD></TR><TR><TD ALIGN="LEFT">− business_category_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− product_category_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− search_center: geography</TD></TR><TR><TD ALIGN="LEFT">− radius_meters: int</TD></TR><TR><TD ALIGN="LEFT">− random_seed: long</TD></TR><TR><TD ALIGN="LEFT">− created_at: datetime</TD></TR></TABLE>>];
RankingCandidate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>RankingCandidate</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Candidato evaluado, visible o no</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− request_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− business_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− product_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− relevance: decimal</TD></TR><TR><TD ALIGN="LEFT">− proximity: decimal</TD></TR><TR><TD ALIGN="LEFT">− availability: decimal</TD></TR><TR><TD ALIGN="LEFT">− activity: decimal</TD></TR><TR><TD ALIGN="LEFT">− equity: decimal</TD></TR><TR><TD ALIGN="LEFT">− new_business_bonus: decimal</TD></TR><TR><TD ALIGN="LEFT">− merit: decimal</TD></TR><TR><TD ALIGN="LEFT">− expected_exposure_share: decimal</TD></TR><TR><TD ALIGN="LEFT">− final_score: decimal</TD></TR><TR><TD ALIGN="LEFT">− position: int</TD></TR></TABLE>>];
OrganicImpression [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>OrganicImpression</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Exposición orgánica observada</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− candidate_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− position: int</TD></TR><TR><TD ALIGN="LEFT">− exposure_weight: decimal</TD></TR><TR><TD ALIGN="LEFT">− deduplication_key: string</TD></TR><TR><TD ALIGN="LEFT">− viewed_at: datetime</TD></TR></TABLE>>];
AdCampaign [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>AdCampaign</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Campaña de producto o promoción</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− business_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− product_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− publication_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− title: string</TD></TR><TR><TD ALIGN="LEFT">− target_center: geography</TD></TR><TR><TD ALIGN="LEFT">− radius_meters: int</TD></TR><TR><TD ALIGN="LEFT">− starts_at: datetime</TD></TR><TR><TD ALIGN="LEFT">− ends_at: datetime</TD></TR><TR><TD ALIGN="LEFT">− status: string</TD></TR><TR><TD ALIGN="LEFT">− approved_at: datetime</TD></TR><TR><TD ALIGN="LEFT">− approved_by: uuid</TD></TR><TR><TD ALIGN="LEFT">− payment_confirmed_at: datetime</TD></TR><TR><TD ALIGN="LEFT">− payment_confirmed_by: uuid</TD></TR><HR/><TR><TD ALIGN="LEFT">+ submitForReview(): void</TD></TR><TR><TD ALIGN="LEFT">+ approve(): void</TD></TR><TR><TD ALIGN="LEFT">+ pause(): void</TD></TR></TABLE>>];
AdImpression [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>AdImpression</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Exposición patrocinada observada</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− campaign_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− discovery_request_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− placement: string</TD></TR><TR><TD ALIGN="LEFT">− session_key: string</TD></TR><TR><TD ALIGN="LEFT">− deduplication_key: string</TD></TR><TR><TD ALIGN="LEFT">− viewed_at: datetime</TD></TR></TABLE>>];
Interaction [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>Interaction</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Visita o intención de contacto</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− business_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− product_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− publication_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− organic_impression_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− ad_impression_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− consumer_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− session_key: string</TD></TR><TR><TD ALIGN="LEFT">− kind: string</TD></TR><TR><TD ALIGN="LEFT">− origin: string</TD></TR><TR><TD ALIGN="LEFT">− deduplication_key: string</TD></TR><TR><TD ALIGN="LEFT">− occurred_at: datetime</TD></TR></TABLE>>]; RankingConfiguration -> DiscoveryRequest [dir=none,taillabel="1",headlabel="0..*",label="configura",labeldistance=2];
DiscoveryRequest -> RankingCandidate [dir=none,taillabel="1",headlabel="0..*",label="evalua",labeldistance=2];
RankingCandidate -> OrganicImpression [dir=none,taillabel="1",headlabel="0..*",label="recibe",labeldistance=2];
AdCampaign -> AdImpression [dir=none,taillabel="1",headlabel="0..*",label="recibe",labeldistance=2];
DiscoveryRequest -> AdImpression [dir=none,taillabel="0..1",headlabel="0..*",label="aloja",labeldistance=2];
OrganicImpression -> Interaction [dir=none,taillabel="0..1",headlabel="0..*",label="origina",labeldistance=2];
AdImpression -> Interaction [dir=none,taillabel="0..1",headlabel="0..*",label="origina",labeldistance=2]; }