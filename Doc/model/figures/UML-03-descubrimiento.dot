digraph G { graph [rankdir=TB,bgcolor="white",pad=0.5,nodesep=0.55,ranksep=1.1,splines=polyline,concentrate=false,fontname="Arial"]; node [shape=plain,fontname="Arial",fontsize=13]; edge [fontname="Arial",fontsize=11,color="#60756c",penwidth=1.2,arrowsize=1.1]; RankingConfiguration [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>RankingConfiguration</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Versión inmutable del algoritmo</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− version<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− context<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− parameters<FONT COLOR="#5d7268"> : json</FONT></TD></TR><TR><TD ALIGN="LEFT">− created_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ validate(): boolean</TD></TR></TABLE>>];
DiscoveryRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>DiscoveryRequest</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Consulta o entrada a la revista</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− configuration_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− consumer_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− session_key<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− context<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− query_text<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− business_category_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− product_category_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− search_center<FONT COLOR="#5d7268"> : geography</FONT></TD></TR><TR><TD ALIGN="LEFT">− radius_meters<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− random_seed<FONT COLOR="#5d7268"> : long</FONT></TD></TR><TR><TD ALIGN="LEFT">− created_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR></TABLE>>];
RankingCandidate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>RankingCandidate</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Candidato evaluado, visible o no</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− request_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− business_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− product_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− relevance<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− proximity<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− availability<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− activity<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− equity<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− new_business_bonus<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− merit<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− expected_exposure_share<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− final_score<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− position<FONT COLOR="#5d7268"> : int</FONT></TD></TR></TABLE>>];
OrganicImpression [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>OrganicImpression</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Exposición orgánica observada</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− candidate_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− position<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− exposure_weight<FONT COLOR="#5d7268"> : decimal</FONT></TD></TR><TR><TD ALIGN="LEFT">− deduplication_key<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− viewed_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR></TABLE>>];
AdCampaign [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>AdCampaign</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Campaña de producto o promoción</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− business_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− product_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− publication_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− title<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− target_center<FONT COLOR="#5d7268"> : geography</FONT></TD></TR><TR><TD ALIGN="LEFT">− radius_meters<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− starts_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR><TR><TD ALIGN="LEFT">− ends_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR><TR><TD ALIGN="LEFT">− status<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− approved_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR><TR><TD ALIGN="LEFT">− approved_by<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− payment_confirmed_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR><TR><TD ALIGN="LEFT">− payment_confirmed_by<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ submitForReview(): void</TD></TR><TR><TD ALIGN="LEFT">+ approve(): void</TD></TR><TR><TD ALIGN="LEFT">+ pause(): void</TD></TR></TABLE>>];
AdImpression [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>AdImpression</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Exposición patrocinada observada</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− campaign_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− discovery_request_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− placement<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− session_key<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− deduplication_key<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− viewed_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR></TABLE>>];
Interaction [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>Interaction</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Visita o intención de contacto</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− business_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− product_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− publication_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− organic_impression_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− ad_impression_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− consumer_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− session_key<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− kind<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− origin<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− deduplication_key<FONT COLOR="#5d7268"> : string</FONT></TD></TR><TR><TD ALIGN="LEFT">− occurred_at<FONT COLOR="#5d7268"> : datetime</FONT></TD></TR></TABLE>>]; RankingConfiguration -> DiscoveryRequest [dir=none,taillabel="1",headlabel="0..*",label="configura",labeldistance=1.9,labelangle=22,labelfontsize=11,labelfontcolor="#3c5a4b"];
