digraph G { graph [rankdir=LR,bgcolor="white",pad=0.4,nodesep=0.5,ranksep=1.2]; node [shape=plain,fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#60756c"]; ProductCategory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>ProductCategory</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Categoría de producto</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">id : uuid PK</TD></TR><TR><TD ALIGN="LEFT">name : string UK</TD></TR></TABLE>>];
Product [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>Product</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Producto por unidad</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">id : uuid PK</TD></TR><TR><TD ALIGN="LEFT">business_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">category_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">name : string </TD></TR><TR><TD ALIGN="LEFT">description : string </TD></TR><TR><TD ALIGN="LEFT">image_url : string </TD></TR><TR><TD ALIGN="LEFT">price : decimal </TD></TR><TR><TD ALIGN="LEFT">currency : string </TD></TR><TR><TD ALIGN="LEFT">status : string </TD></TR></TABLE>>];
Inventory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>Inventory</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Saldo de stock</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">product_id : uuid PK,FK</TD></TR><TR><TD ALIGN="LEFT">business_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">quantity : int </TD></TR><TR><TD ALIGN="LEFT">low_stock_threshold : int </TD></TR><TR><TD ALIGN="LEFT">version : long </TD></TR></TABLE>>];
OrderRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>OrderRequest</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Solicitud previa al contacto</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">id : uuid PK</TD></TR><TR><TD ALIGN="LEFT">business_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">consumer_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">source_interaction_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">reference : string UK</TD></TR><TR><TD ALIGN="LEFT">access_token_hash : string </TD></TR><TR><TD ALIGN="LEFT">contact_name : string </TD></TR><TR><TD ALIGN="LEFT">contact_phone : string </TD></TR><TR><TD ALIGN="LEFT">status : string </TD></TR><TR><TD ALIGN="LEFT">origin : string </TD></TR><TR><TD ALIGN="LEFT">idempotency_key : string </TD></TR><TR><TD ALIGN="LEFT">created_at : datetime </TD></TR><TR><TD ALIGN="LEFT">contact_confirmed_at : datetime </TD></TR><TR><TD ALIGN="LEFT">contact_confirmed_by : uuid FK</TD></TR></TABLE>>];
OrderItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>OrderItem</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Copia de lo solicitado</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">id : uuid PK</TD></TR><TR><TD ALIGN="LEFT">business_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">order_request_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">product_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">product_name_snapshot : string </TD></TR><TR><TD ALIGN="LEFT">quantity : int </TD></TR><TR><TD ALIGN="LEFT">unit_price_snapshot : decimal </TD></TR><TR><TD ALIGN="LEFT">currency : string </TD></TR></TABLE>>];
Sale [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>Sale</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Venta reportada</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">id : uuid PK</TD></TR><TR><TD ALIGN="LEFT">business_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">order_request_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">recorded_by : uuid FK</TD></TR><TR><TD ALIGN="LEFT">origin : string </TD></TR><TR><TD ALIGN="LEFT">status : string </TD></TR><TR><TD ALIGN="LEFT">idempotency_key : string </TD></TR><TR><TD ALIGN="LEFT">recorded_at : datetime </TD></TR></TABLE>>];
SaleItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>SaleItem</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Copia de lo efectivamente vendido</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">id : uuid PK</TD></TR><TR><TD ALIGN="LEFT">business_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">sale_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">product_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">product_name_snapshot : string </TD></TR><TR><TD ALIGN="LEFT">quantity : int </TD></TR><TR><TD ALIGN="LEFT">unit_price : decimal </TD></TR><TR><TD ALIGN="LEFT">currency : string </TD></TR></TABLE>>];
StockMovement [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>StockMovement</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Movimiento firmado de unidades</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">id : uuid PK</TD></TR><TR><TD ALIGN="LEFT">business_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">product_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">sale_item_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">actor_id : uuid FK</TD></TR><TR><TD ALIGN="LEFT">quantity_delta : int </TD></TR><TR><TD ALIGN="LEFT">kind : string </TD></TR><TR><TD ALIGN="LEFT">reason : string </TD></TR><TR><TD ALIGN="LEFT">operation_key : string </TD></TR><TR><TD ALIGN="LEFT">occurred_at : datetime </TD></TR></TABLE>>]; ProductCategory -> Product [dir=none,taillabel="1",headlabel="0..*",label="clasifica",labeldistance=2];
Product -> Inventory [dir=none,taillabel="1",headlabel="1",label="mantiene",labeldistance=2];
OrderRequest -> OrderItem [dir=none,taillabel="1",headlabel="1..*",label="contiene",labeldistance=2];
Product -> OrderItem [dir=none,taillabel="1",headlabel="0..*",label="solicitado",labeldistance=2];
OrderRequest -> Sale [dir=none,taillabel="0..1",headlabel="0..1",label="se_convierte",labeldistance=2];
Sale -> SaleItem [dir=none,taillabel="1",headlabel="1..*",label="contiene",labeldistance=2];
Product -> SaleItem [dir=none,taillabel="1",headlabel="0..*",label="vendido",labeldistance=2];
Inventory -> StockMovement [dir=none,taillabel="1",headlabel="0..*",label="historial",labeldistance=2];
SaleItem -> StockMovement [dir=none,taillabel="0..1",headlabel="0..*",label="origina",labeldistance=2]; }