Subscription [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>Subscription</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Período de suscripción</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− business_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− plan_id: uuid</TD></TR><TR><TD ALIGN="LEFT">− status: string</TD></TR><TR><TD ALIGN="LEFT">− starts_at: datetime</TD></TR><TR><TD ALIGN="LEFT">− ends_at: datetime</TD></TR><TR><TD ALIGN="LEFT">− activated_by: uuid</TD></TR><HR/><TR><TD ALIGN="LEFT">+ isEffective(at): boolean</TD></TR></TABLE>>];
