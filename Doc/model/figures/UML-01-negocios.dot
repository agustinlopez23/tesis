digraph G { graph [rankdir=LR,bgcolor="white",pad=0.4,nodesep=0.5,ranksep=1.2]; node [shape=plain,fontname="Arial",fontsize=12]; edge [fontname="Arial",fontsize=10,color="#60756c"]; UserAccount [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2eee9"><B>UserAccount</B></TD></TR><TR><TD><FONT POINT-SIZE="10">Cuenta de usuario</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id: uuid</TD></TR><TR><TD ALIGN="LEFT">− email: string</TD></TR><TR><TD ALIGN="LEFT">− display_name: string</TD></TR><TR><TD ALIGN="LEFT">− status: string</TD></TR><TR><TD ALIGN="LEFT">− created_at: datetime</TD></TR><TR><TD ALIGN="LEFT">− password_hash: string</TD></TR><HR/><TR><TD ALIGN="LEFT">+ activate(): void</TD></TR><TR><TD ALIGN="LEFT">+ suspend(): void</TD></TR></TABLE>>];
