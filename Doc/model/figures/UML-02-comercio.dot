digraph G { graph [rankdir=TB,bgcolor="white",pad=0.5,nodesep=0.55,ranksep=1.1,splines=polyline,concentrate=false,fontname="Arial"]; node [shape=plain,fontname="Arial",fontsize=13]; edge [fontname="Arial",fontsize=11,color="#60756c",penwidth=1.2,arrowsize=1.1]; ProductCategory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>ProductCategory</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Categoría de producto</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− name<FONT COLOR="#5d7268"> : string</FONT></TD></TR></TABLE>>];
