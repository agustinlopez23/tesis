Inventory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#3f5d4e"><TR><TD BGCOLOR="#cfe0d6"><B>Inventory</B></TD></TR><TR><TD BGCOLOR="#e8f0ea"><FONT POINT-SIZE="10" COLOR="#40564a">Saldo de stock</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">− product_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− business_id<FONT COLOR="#5d7268"> : uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">− quantity<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− low_stock_threshold<FONT COLOR="#5d7268"> : int</FONT></TD></TR><TR><TD ALIGN="LEFT">− version<FONT COLOR="#5d7268"> : long</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ applyMovement(delta): void</TD></TR></TABLE>>];
