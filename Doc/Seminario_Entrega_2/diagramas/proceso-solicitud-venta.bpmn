<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions" targetNamespace="https://tesis.local/model">
<bpmn:collaboration id="Collaboration"><bpmn:participant id="Pool" name="Solicitud y venta — proceso propuesto" processRef="Process"/></bpmn:collaboration>
<bpmn:process id="Process" isExecutable="false"><bpmn:laneSet id="LaneSet"><bpmn:lane id="consumer" name="Consumidor"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>choose</bpmn:flowNodeRef><bpmn:flowNodeRef>sendDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>send</bpmn:flowNodeRef><bpmn:flowNodeRef>pending</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="platform" name="Plataforma"><bpmn:flowNodeRef>request</bpmn:flowNodeRef><bpmn:flowNodeRef>commit</bpmn:flowNodeRef><bpmn:flowNodeRef>sold</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="business" name="Negocio"><bpmn:flowNodeRef>attend</bpmn:flowNodeRef><bpmn:flowNodeRef>saleDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>cancelled</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="start" name="Interés en producto"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="choose" name="Revisar productos"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="request" name="Crear solicitud sin reservar stock"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="sendDecision" name="¿Envía mensaje?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="send" name="Enviar por WhatsApp (externo)"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="pending" name="Solicitud pendiente"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="attend" name="Atender consulta y acordar venta"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="saleDecision" name="¿Se concreta?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="confirm" name="Confirmar artículos, cantidades y origen"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="commit" name="Registrar venta y stock atómicamente"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="sold" name="Venta registrada"><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="cancel" name="Cancelar solicitud con motivo"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="cancelled" name="Solicitud cancelada"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="choose" name=""/><bpmn:sequenceFlow id="f2" sourceRef="choose" targetRef="request" name=""/><bpmn:sequenceFlow id="f3" sourceRef="request" targetRef="sendDecision" name=""/><bpmn:sequenceFlow id="f4" sourceRef="sendDecision" targetRef="send" name="Sí"/><bpmn:sequenceFlow id="f5" sourceRef="sendDecision" targetRef="pending" name="No"/><bpmn:sequenceFlow id="f6" sourceRef="send" targetRef="attend" name=""/><bpmn:sequenceFlow id="f7" sourceRef="attend" targetRef="saleDecision" name=""/><bpmn:sequenceFlow id="f8" sourceRef="saleDecision" targetRef="confirm" name="Sí"/><bpmn:sequenceFlow id="f9" sourceRef="saleDecision" targetRef="cancel" name="No"/><bpmn:sequenceFlow id="f10" sourceRef="confirm" targetRef="commit" name=""/><bpmn:sequenceFlow id="f11" sourceRef="commit" targetRef="sold" name=""/><bpmn:sequenceFlow id="f12" sourceRef="cancel" targetRef="cancelled" name=""/></bpmn:process><bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration"><bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="10" y="100" width="1980" height="620"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="consumer_di" bpmnElement="consumer" isHorizontal="true"><dc:Bounds x="40" y="100" width="1950" height="180"/></bpmndi:BPMNShape><bp