#!/bin/sh
set -eu
repo=$(git rev-parse --show-toplevel)
cd "$repo"
if [ -x "$repo/.tools/security/gitleaks/gitleaks.exe" ]; then
  scanner="$repo/.tools/security/gitleaks/gitleaks.exe"
elif command -v gitleaks >/dev/null 2>&1; then
  scanner=gitleaks
else
  echo "Falta Gitleaks. No se puede verificar el historial antes del push." >&2
  exit 1
fi
exec "$scanner" git --redact --no-banner --ignore-gitleaks-allow --log-opts="--all"
